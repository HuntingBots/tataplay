<?php
/*
 * get-mpd.php — returns the DRM DASH manifest for a TataPlay channel.
 *
 * Upstream provides CENC-encrypted DASH manifests with Widevine and PlayReady DRM.
 * This script resolves the upstream stream URL using authorized session credentials,
 * fetches the upstream DASH manifest, rewrites <BaseURL> and segment URLs with the
 * required authentication parameters, ensures standard CENC/PSSH signalling, and
 * outputs a compliant, valid MPD manifest.
 */

include 'app/functions.php';

if (!$id) {
    http_response_code(400);
    header('Content-Type: text/plain');
    echo 'Missing content ID.';
    exit;
}

if (!file_exists($loginFilePath)) {
    http_response_code(401);
    header('Content-Type: text/plain');
    echo 'Login required.';
    exit;
}

$loginData = json_decode(file_get_contents($loginFilePath), true);
if (!isset($loginData['data']['subscriberId']) || !isset($loginData['data']['userAuthenticateToken'])) {
    http_response_code(403);
    header('Content-Type: text/plain');
    echo 'Invalid login data.';
    exit;
}

$subscriberId = $loginData['data']['subscriberId'];
$userToken    = $loginData['data']['userAuthenticateToken'];

$format = strtolower(isset($_GET['format']) ? (string)$_GET['format'] : 'mpd');
if (!in_array($format, ['mpd', 'm3u8'], true)) {
    http_response_code(400);
    echo 'Unsupported format. Use ?format=mpd or ?format=m3u8.';
    exit;
}

if ($format === 'm3u8') {
    http_response_code(406);
    header('Content-Type: application/json');
    header('Cache-Control: no-store');
    header('X-TT-DRM: cenc');
    echo json_encode([
        'error'         => 'HLS_NOT_AVAILABLE',
        'reason'        => 'Upstream offers DRM-protected DASH (Widevine/PlayReady, CENC) only. Producing playable HLS requires decrypting segments, which this project does not do.',
        'content_id'    => (string)$id,
        'mpd_available' => true,
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
    exit;
}

function tt_url_expiry(string $url): ?int {
    $q = [];
    parse_str(parse_url($url, PHP_URL_QUERY) ?? '', $q);
    if (isset($q['exp']) && is_numeric($q['exp'])) return (int)$q['exp'];
    if (isset($q['hdnea'])) {
        $h = [];
        parse_str(str_replace('~', '&', $q['hdnea']), $h);
        if (isset($h['exp']) && is_numeric($h['exp'])) return (int)$h['exp'];
    }
    if (isset($q['hdntl'])) {
        $h = [];
        parse_str(str_replace('~', '&', $q['hdntl']), $h);
        if (isset($h['exp']) && is_numeric($h['exp'])) return (int)$h['exp'];
    }
    return null;
}

$cacheData = file_exists($cachePath) ? json_decode(file_get_contents($cachePath), true) ?? [] : [];
$mpdurl    = null;
$useCache  = false;

if (isset($cacheData[$id])) {
    $cachedUrl = $cacheData[$id]['url'] ?? null;
    if ($cachedUrl) {
        $exp = tt_url_expiry($cachedUrl);
        // Ensure at least 60 seconds of token lifetime remains
        if ($exp && time() < ($exp - 60)) {
            $mpdurl   = $cachedUrl;
            $useCache = true;
        }
    }
}

if (!$useCache || !$mpdurl) {
    $headers = [
        'Authorization: Bearer ' . $userToken,
        'subscriberId: ' . $subscriberId,
        "User-Agent: $ua",
        'Origin: https://www.tataplaybinge.com',
        'Referer: https://www.tataplaybinge.com/'
    ];

    $contentResp = fetchHttp($content_api, [
        'method'  => 'GET',
        'headers' => $headers,
        'timeout' => 10
    ]);

    if ($contentResp['status'] !== 200 || empty($contentResp['body'])) {
        http_response_code(502);
        header('Content-Type: text/plain');
        echo "Failed to fetch content data from upstream API (HTTP {$contentResp['status']}).";
        exit;
    }

    $responseData = json_decode($contentResp['body'], true);
    $encDashUrl = $responseData['data']['dashPlayreadyPlayUrl']
               ?? $responseData['data']['dashWidewinePlayUrl']
               ?? null;

    if (!$encDashUrl) {
        http_response_code(404);
        header('Content-Type: text/plain');
        echo 'Stream playback URL not found in upstream response.';
        exit;
    }

    $decryptedUrl = decryptUrl($encDashUrl, $aesKey);
    if (!$decryptedUrl) {
        http_response_code(500);
        header('Content-Type: text/plain');
        echo 'Failed to decrypt stream playback URL.';
        exit;
    }

    $mpdurl = $decryptedUrl;
    $cacheData[$id] = ['url' => $mpdurl, 'updated_at' => time()];
    @mkdir(dirname($cachePath), 0777, true);
    file_put_contents($cachePath, json_encode($cacheData, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
}

// Fetch the MPD manifest
$manifestResp = fetchHttp($mpdurl, [
    'headers' => [
        "User-Agent: $ua",
        'Origin: https://watch.tataplay.com',
        'Referer: https://watch.tataplay.com/'
    ],
    'timeout' => 12
]);

if ($manifestResp['status'] !== 200 || empty($manifestResp['body'])) {
    http_response_code(502);
    header('Content-Type: text/plain');
    echo "Failed to fetch DASH manifest from CDN (HTTP {$manifestResp['status']}).";
    exit;
}

$rawManifest = $manifestResp['body'];

// Parse and process MPD XML
$dom = new DOMDocument();
$dom->preserveWhiteSpace = false;
$dom->formatOutput = true;

if (!@$dom->loadXML($rawManifest)) {
    http_response_code(502);
    header('Content-Type: text/plain');
    echo 'Failed to parse upstream DASH manifest XML.';
    exit;
}

$xpath = new DOMXPath($dom);
$xpath->registerNamespace('mpd', 'urn:mpeg:dash:schema:mpd:2011');
$xpath->registerNamespace('cenc', 'urn:mpeg:cenc:2013');

// Ensure root <MPD> has xmlns:cenc
$root = $dom->documentElement;
if (!$root->hasAttribute('xmlns:cenc')) {
    $root->setAttribute('xmlns:cenc', 'urn:mpeg:cenc:2013');
}

// Resolve CDN base directory and auth query parameters
$parsedUrl = parse_url($mpdurl);
$baseUrlDir = rtrim(dirname($parsedUrl['path'] ?? '/'), '/');
$cdnBase = ($parsedUrl['scheme'] ?? 'https') . '://' . ($parsedUrl['host'] ?? '') . $baseUrlDir;
$authQuery = $parsedUrl['query'] ?? '';

// Rewrite <BaseURL> to point to CDN dash directory (without query parameters)
$baseNodes = $xpath->query('//mpd:BaseURL');
if ($baseNodes->length > 0) {
    foreach ($baseNodes as $bNode) {
        $val = trim($bNode->textContent);
        if ($val === '' || strpos($val, 'http') === 0) continue;
        $bNode->textContent = rtrim($cdnBase, '/') . '/' . trim($val, '/') . '/';
    }
} else {
    $periods = $xpath->query('//mpd:Period');
    if ($periods->length > 0) {
        $p = $periods->item(0);
        $newBaseNode = $dom->createElementNS('urn:mpeg:dash:schema:mpd:2011', 'BaseURL', rtrim($cdnBase, '/') . '/dash/');
        $p->insertBefore($newBaseNode, $p->firstChild);
    }
}

// Append auth token query string to initialization and media attributes in SegmentTemplate
if ($authQuery) {
    $templateNodes = $xpath->query('//mpd:SegmentTemplate');
    foreach ($templateNodes as $tpl) {
        if ($tpl->hasAttribute('initialization')) {
            $initVal = $tpl->getAttribute('initialization');
            if (strpos($initVal, '?') === false) {
                $tpl->setAttribute('initialization', $initVal . '?' . $authQuery);
            }
        }
        if ($tpl->hasAttribute('media')) {
            $mediaVal = $tpl->getAttribute('media');
            if (strpos($mediaVal, '?') === false) {
                $tpl->setAttribute('media', $mediaVal . '?' . $authQuery);
            }
        }
    }
}

// Extract and inject PSSH and default_KID if not already present
$psshData = extractPsshFromManifest($rawManifest, $cdnBase, $authQuery, $ua);
if ($psshData) {
    if (!empty($psshData['kid'])) {
        $cencNodes = $xpath->query('//mpd:ContentProtection[@schemeIdUri="urn:mpeg:dash:mp4protection:2011"]');
        foreach ($cencNodes as $node) {
            if (!$node->hasAttribute('cenc:default_KID')) {
                $node->setAttribute('cenc:default_KID', $psshData['kid']);
            }
        }
    }

    if (!empty($psshData['wv_pssh'])) {
        $wvNodes = $xpath->query('//mpd:ContentProtection[contains(translate(@schemeIdUri,"ABCDEFGHIJKLMNOPQRSTUVWXYZ","abcdefghijklmnopqrstuvwxyz"),"edef8ba9")]');
        foreach ($wvNodes as $node) {
            $existingPssh = $xpath->query('.//cenc:pssh', $node);
            if ($existingPssh->length === 0) {
                $psshEl = $dom->createElementNS('urn:mpeg:cenc:2013', 'cenc:pssh', $psshData['wv_pssh']);
                $node->appendChild($psshEl);
            }
        }
    }

    if (!empty($psshData['pr_pssh'])) {
        $prNodes = $xpath->query('//mpd:ContentProtection[contains(translate(@schemeIdUri,"ABCDEFGHIJKLMNOPQRSTUVWXYZ","abcdefghijklmnopqrstuvwxyz"),"9a04f079")]');
        foreach ($prNodes as $node) {
            $existingPssh = $xpath->query('.//cenc:pssh', $node);
            if ($existingPssh->length === 0) {
                $psshEl = $dom->createElementNS('urn:mpeg:cenc:2013', 'cenc:pssh', $psshData['pr_pssh']);
                $node->appendChild($psshEl);
            }
        }
    }
}

$isDrm = ($xpath->query('//mpd:ContentProtection')->length > 0);

header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Methods: GET, POST, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization, Range, Origin, Referer');
header('Content-Security-Policy: default-src \'self\';');
header('X-Content-Type-Options: nosniff');
header('X-Frame-Options: DENY');
header('X-TT-Format: mpd');
header('X-TT-DRM: ' . ($isDrm ? 'cenc' : 'none'));
header('Content-Type: application/dash+xml; charset=utf-8');
header('Content-Disposition: inline; filename="tp' . urlencode($id) . '.mpd"');

echo $dom->saveXML();
